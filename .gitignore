# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local MCP secrets (use .cursor/mcp.json.example as template)
.cursor/mcp.json

# waitlist data (local storage)
/data/waitlist.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright debug output
.playwright-mcp/
.worktrees/
.superpowers/
*.png
*.jpeg

# local dev-server process artifacts
.codex-next-*.log
.codex-next-*.pid
